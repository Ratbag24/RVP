# Migrations and administrative work connect as the owner role (holds BYPASSRLS).
RVP_OWNER_DATABASE_URL=postgresql+psycopg://rvp_owner:rvp_owner@127.0.0.1:5432/rvp
# The application connects as the unprivileged role, so RLS policies apply to it.
RVP_APP_DATABASE_URL=postgresql+psycopg://rvp_app:rvp_app@127.0.0.1:5432/rvp

# The test suite uses a separate database and drops/recreates the schema in it.
RVP_TEST_OWNER_DATABASE_URL=postgresql+psycopg://rvp_owner:rvp_owner@127.0.0.1:5432/rvp_test
RVP_TEST_APP_DATABASE_URL=postgresql+psycopg://rvp_app:rvp_app@127.0.0.1:5432/rvp_test

# The role the migration grants table privileges to.
RVP_APP_ROLE=rvp_app
